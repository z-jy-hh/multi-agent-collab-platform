# Copy this file to .env (UTF-8) and fill in your key — R27: the principal
# (never the executor) creates .env. Without it the system runs fully
# offline on FakeLLM.

OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
MODEL=deepseek-chat

# Optional web search (only used when set; local corpus stays the default, C9)
TAVILY_API_KEY=
